# ============================================================
# ARABICATION — Environment Variables
# Bu faylni nusxalab ".env" nomi bilan saqlang va haqiqiy
# qiymatlarni to'ldiring. ".env" fayli hech qachon Git'ga
# push qilinmaydi (.gitignore ichida ko'rsatilgan).
# ============================================================

# ---- Web server (server.js / Express) ----
PORT=3000

# Supabase loyihangizning Project URL va anon (public) key'i.
# Bularni Supabase Dashboard > Project Settings > API bo'limidan oling.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Telegram bot username (@ belgisiz) — duel havolalari uchun ishlatiladi
BOT_USERNAME=arabicationbot
# Faqat BotFather'da /newapp orqali alohida nomlangan Web App yaratgan bo'lsangiz kerak
WEBAPP_SHORT_NAME=

# Admin panelni ko'ra oladigan Telegram foydalanuvchi ID'lari, vergul bilan ajratilgan
# (masalan: 111111111,222222222). Bo'sh qoldirsangiz hech kim admin panelini ko'rmaydi.
# DIQQAT: bu faqat frontendda tugmani ko'rsatish/yashirish uchun — haqiqiy himoya
# Supabase RLS/RPC darajasida ta'minlanishi shart.
ADMIN_TELEGRAM_IDS=

# ---- Telegram bot (bot.py) ----
BOT_TOKEN=your-telegram-bot-token
WEBAPP_URL=https://your-deployed-app-url.com
# Bosh adminning shaxsiy Telegram ID'si (masalan @userinfobot orqali bilib oling)
ADMIN_ID=

# Supabase service_role key — FAQAT bot.py (serverda) ishlatadi, hech qachon
# frontendga yoki ADMIN_TELEGRAM_IDS/anon key o'rniga ishlatilmasin.
SUPABASE_KEY=your-supabase-service-role-key
